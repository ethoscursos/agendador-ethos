{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agendador-ethos-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",

  "d1_databases": [
    {
      "binding": "AGENDADOR_DB",
      "database_name": "agendador-ethos-d1",
      "database_id": "<preencher após wrangler d1 create>",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    { "binding": "CONVERSA_KV", "id": "<preencher após kv namespace create>" },
    { "binding": "LEMBRETE_KV", "id": "<preencher após kv namespace create>" }
  ],

  "queues": {
    "producers": [
      { "binding": "FILA_MENSAGENS", "queue": "envio-mensagens" }
    ],
    "consumers": [
      { "queue": "envio-mensagens", "max_batch_size": 10, "max_retries": 3 }
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "FUSO": "America/Sao_Paulo",
    "TIMEOUT_MINUTOS": 30,
    "INSTANCIA_PROFISSIONAL_MAP": "prof7=7",
    "INSTANCIA_APIKEY_MAP": "prof7=<APIKEY_DA_INSTANCIA>"
  },

  "triggers": {
    "crons": ["0 8 * * *"]
  },

  "routes": [
    { "pattern": "agendador.ethoscursos.com.br/webhook*", "zone_id": "<ZONE_ID>" },
    { "pattern": "agendador.ethoscursos.com.br/api/*", "zone_id": "<ZONE_ID>" }
  ]
}