{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agendador-ethos-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",

  "d1_databases": [
    {
      "binding": "AGENDADOR_DB",
      "database_name": "agendador-ethos-d1",
      "database_id": "edae617e-b927-45ec-974d-2707787116a8",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    { "binding": "CONVERSA_KV", "id": "8ac0f31faa614076a7261d4acbc9a99c" },
    { "binding": "LEMBRETE_KV", "id": "f1f987ce2ab84e0d945604158212f0a1" }
  ],

  "queues": {
    "producers": [
      { "binding": "FILA_MENSAGENS", "queue": "envio-mensagens" }
    ],
    "consumers": [
      { "queue": "envio-mensagens", "max_batch_size": 10, "max_retries": 3 }
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "FUSO": "America/Sao_Paulo",
    "TIMEOUT_MINUTOS": 30,
    "INSTANCIA_PROFISSIONAL_MAP": "prof7=7",
    "INSTANCIA_APIKEY_MAP": "prof7=<APIKEY_DA_INSTANCIA>"
  },

  "triggers": {
    "crons": ["0 11 * * *"]
  },

  "routes": [
    { "pattern": "agendador.ethoscursos.com.br/webhook*", "zone_id": "330f15f6d6ef37f935a1a4af9f690e29" },
    { "pattern": "agendador.ethoscursos.com.br/api/*", "zone_id": "330f15f6d6ef37f935a1a4af9f690e29" },
    { "pattern": "agendador.ethoscursos.com.br/health", "zone_id": "330f15f6d6ef37f935a1a4af9f690e29" }
  ]
}